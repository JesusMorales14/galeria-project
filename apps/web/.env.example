# API del museo (por defecto, la pública). En e2e y Lighthouse CI se apunta a la API simulada.
AIC_API_BASE_URL=https://api.artic.edu/api/v1
AIC_USER_AGENT="galeria (https://github.com/JesusMorales14/galeria-project)"

# URL pública del sitio (opcional; en Vercel se toma VERCEL_PROJECT_PRODUCTION_URL).
NEXT_PUBLIC_SITE_URL=

# Sentry (opcional: sin DSN no se envía nada)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Solo en el entorno de build (secreto): permite subir los source maps.
SENTRY_AUTH_TOKEN=

# Ruta /api/debug/error para el incidente simulado. Solo en vistas previas.
ENABLE_DEBUG_ROUTES=
