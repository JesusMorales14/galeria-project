# API del museo (por defecto, la pública). En e2e y Lighthouse CI se apunta a la API simulada.
AIC_API_BASE_URL=https://api.artic.edu/api/v1
# Servidor de imágenes que usa el proxy /api/iiif (el navegador nunca lo llama directamente).
AIC_IIIF_BASE_URL=https://www.artic.edu/iiif/2
AIC_USER_AGENT="galeria (https://github.com/JesusMorales14/galeria-project)"

# Secreto para firmar los tokens de sesión (obligatorio en producción, ≥ 32 caracteres).
# Genera uno con: openssl rand -base64 48
AUTH_SECRET=

# Base de datos de cuentas y sesiones (obligatoria en producción). En Railway:
# DATABASE_URL=${{Postgres.DATABASE_URL}}. Sin ella, en desarrollo se usa memoria.
DATABASE_URL=
# Solo para pruebas contra el build sin base de datos: AUTH_STORAGE=memory
AUTH_STORAGE=

# URL pública del sitio (opcional; en Railway se toma RAILWAY_PUBLIC_DOMAIN y en Vercel,
# VERCEL_PROJECT_PRODUCTION_URL).
NEXT_PUBLIC_SITE_URL=

# Sentry (opcional: sin DSN no se envía nada)
NEXT_PUBLIC_SENTRY_DSN=
SENTRY_ORG=
SENTRY_PROJECT=
# Solo en el entorno de build (secreto): permite subir los source maps.
SENTRY_AUTH_TOKEN=

# Ruta /api/debug/error para el incidente simulado. Solo en vistas previas.
ENABLE_DEBUG_ROUTES=
